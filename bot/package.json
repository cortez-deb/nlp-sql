{
  "name": "nlsql-bot",
  "version": "1.0.0",
  "private": true,
  "description": "WhatsApp webhook bot for nlsql",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm --prefix .. run build && tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "tsc --noEmit",
    "register-webhook": "tsx scripts/registerWebhook.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.0.0",
    "nlsql": "file:..",
    "pg": "^8.23.1",
    "pino": "^9.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "jest": "^29.7.0",
    "pino-pretty": "^11.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^cookie$": "<rootDir>/tests/mocks/cookie.js"
    }
  }
}
