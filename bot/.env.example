# Server configuration
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# WhatsApp Gateway selection: 'openwa-gateway' or 'wa-automate'
OPENWA_FLAVOR=openwa-gateway

# Webhook security
# Path token: random secret string at least 24 characters long
WEBHOOK_PATH_TOKEN=your-random-webhook-path-token-at-least-24-chars
# HMAC Secret: required for openwa-gateway (at least 16 characters)
WEBHOOK_HMAC_SECRET=your-webhook-hmac-secret-at-least-16-chars
# Public URL for webhook registration script
WEBHOOK_PUBLIC_URL=https://your-bot-domain.com/webhook/your-random-webhook-path-token-at-least-24-chars

# OpenWA Gateway settings
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=your-openwa-gateway-api-key
OPENWA_SESSION_ID=your-session-id
TYPING_INDICATOR=false

# Optional overrides for gateway endpoints
# OPENWA_API_KEY_HEADER=X-API-Key
# OPENWA_SEND_TEXT_PATH=/api/sessions/{sessionId}/messages/send-text

# Access Control: comma-separated ownerId:chatId pairs
# (Owner ID must match regex ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$)
ALLOWED_SENDERS=david:254712345678@c.us,david:98765432101234@lid

# Database connection (SELECT-only user recommended)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nlsql_user
DB_PASSWORD=your-db-password
DB_NAME=shop
DB_SSL=false
# DB_SSL_CA=/path/to/ca.pem

# Gemini LLM configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Schema enrichment storage
ENRICHMENT_PATH=./.nlsql/enrichment.json

# CSV Export (Phase 2 integration)
EXPORT_BASE_URL=https://files.yourdomain.com/downloads
EXPORT_DOWNLOAD_DIR=/var/www/downloads
EXPORT_RETENTION_HOURS=24
EXPORT_MAX_ROWS=100000
# EXPORT_SIGNING_KEY=your-secret-signing-key-at-least-32-chars

# Locale and limits
TZ=Africa/Nairobi
LOCALE=en-US
MAX_MESSAGE_AGE_SEC=120
RATE_LIMIT_PER_MIN=10
DAILY_QUERY_LIMIT=200

# Capture mode: set to 1 or true to log incoming payloads to .capture/ without answering
CAPTURE_MODE=0
