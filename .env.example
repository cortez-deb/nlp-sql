# Copy to .env and fill in. Never commit the real .env (it is git-ignored).

# ── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=

# ── Gemini ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# A model id that exists for your key (list with GET /v1beta/models)
GEMINI_MODEL=

# ── CSV export (Phase 2) ────────────────────────────────────────────────────
# Directory the separate web app serves. Must exist and be writable by this process.
EXPORT_ROOT_DIR=/var/www/downloads
# Public base URL of the web app's download route. Required. https:// only
# (http://localhost and http://127.0.0.1 are allowed for development). No trailing slash.
EXPORT_BASE_URL=
# How long a download link stays valid, in hours (default 24)
EXPORT_TTL_HOURS=
# Maximum rows written to one export (default 100000)
EXPORT_MAX_ROWS=
# Maximum size of one export in MB (default 50)
EXPORT_MAX_MB=
# Export query + write time limit in milliseconds (default 60000)
EXPORT_TIMEOUT_MS=
